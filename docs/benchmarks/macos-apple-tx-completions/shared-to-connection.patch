+static void configure_send(INFlow *flow) {
+    // A single heap block for the connection. Close breaks this intentional
+    // self-reference; outstanding sends keep the block and signal owner alive.
+    #pragma clang diagnostic push
+    #pragma clang diagnostic ignored "-Warc-retain-cycles"
+    flow->sendCompletion = ^(nw_error_t e) {
+        size_t previous = 0;
+        if (++flow->completedCredits == TX_CREDIT_GROUP) {
+            flow->completedCredits = 0;
+            previous = atomic_fetch_sub_explicit(&flow->pending, TX_CREDIT_GROUP, memory_order_acq_rel);
+        }
+        if (atomic_load_explicit(&flow->closing, memory_order_acquire)) return;
+        if (e) fail(flow, posix_error(e));
+        else if (previous == TX_SLOTS) {
+            atomic_fetch_add_explicit(&flow->txWakes, 1, memory_order_relaxed);
+            notify(flow, true);
+        }
+    };
+    #pragma clang diagnostic pop
 }
 
